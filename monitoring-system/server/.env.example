# Copy to `.env` and fill in. Never commit the real .env.
#
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | production | testing
FLASK_ENV=development

# --- Database ---------------------------------------------------------------
# MariaDB/MySQL:  mysql+pymysql://user:password@host:3306/dbname
# Postgres:       postgresql://user:password@host:5432/dbname
# SQLite (dev):   leave unset to use sqlite:///monitoring_dev.db
DATABASE_URL=mysql+pymysql://root:@localhost:3306/monitoring

# --- Secrets (REQUIRED in production; app refuses to start otherwise) -------
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# --- Tokens --------------------------------------------------------------------
JWT_ACCESS_TOKEN_EXPIRES=3600      # seconds (1 hour)
JWT_REFRESH_TOKEN_EXPIRES=604800   # seconds (7 days)

# --- CORS --------------------------------------------------------------------
# Comma-separated allowed origins. Use the real dashboard origin in production.
CORS_ORIGINS=http://localhost:5173

# --- Authentication hardening ----------------------------------------------
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
EMAIL_CHECK_DELIVERABILITY=false   # set true in prod to verify the domain has MX records

# --- Rate limiting ---------------------------------------------------------
# memory:// is per-process. Use redis://localhost:6379 with multiple workers.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per hour

# --- Reverse proxy -------------------------------------------------------------
# Only set true when running behind a proxy you control (nginx/traefik), so
# X-Forwarded-For is trusted for rate-limiting / lockout.
TRUST_PROXY=false
